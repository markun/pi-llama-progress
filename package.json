{
  "name": "pi-llama-progress",
  "version": "0.1.0",
  "description": "Progress bar + TPS overlay for pi with llama.cpp and TabbyAPI. Live prefill/generation progress where the server exposes it, plus end-of-turn stats.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "llama-cpp",
    "tabbyapi"
  ],
  "main": "./src/index.ts",
  "type": "module",
  "license": "MIT",
  "author": "Marcoen Hirschberg",
  "repository": "github:markun/pi-llama-progress",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
